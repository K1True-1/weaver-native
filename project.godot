; Weaver: an independent native Godot desktop game.
config_version=5
[application]
config/name="织律者 · 规则之外"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.5.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="Weaver/Native-0.5"
[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/resizable=true
window/size/min_width=1120
window/size/min_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.024,0.044,0.066,1)
[gui]
common/drop_mouse_on_gui_input_disabled=true
[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inference_on_variant=0
